<mvc:View controllerName="com.gsitm.pkg.co.zgspkgco0060.controller.Main" displayBlock="true"
    xmlns:table="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:svm="sap.ui.comp.smartvariants"
    xmlns:columnmenu="sap.m.table.columnmenu">
    <f:DynamicPage headerExpanded="{/headerExpanded}">
        <f:header>
            <f:DynamicPageHeader>
                <f:content>
                    <fb:FilterBar id="FB_MainSearch" useToolbar="false" search=".onSearch" showFilterConfiguration="false">
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem name="CompanyCode" label="{i18n>CompanyCode}" groupName="MainSearch" mandatory="true" visibleInFilterBar="true">
                                <fb:control>
                                    <Input id="IP_CompanyCode" value="{Search>/CompanyCode}" required="true" />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <!-- 시작 기간 -->
                            <fb:FilterGroupItem name="PriorStartMonth" label="{i18n>PriorStartMonth}" groupName="MainSearch" visibleInFilterBar="true" mandatory="true">
                                <fb:control>
                                    <MultiInput id="MI_PriorStartMonth" width="8rem" showValueHelp="false" />
                                </fb:control>
                            </fb:FilterGroupItem>

                            <fb:FilterGroupItem name="PriorEndMonth" label="{i18n>PriorEndMonth}" groupName="MainSearch" visibleInFilterBar="true" mandatory="true">
                                <fb:control>
                                    <MultiInput id="MI_PriorEndMonth" width="8rem" showValueHelp="false" />
                                </fb:control>
                            </fb:FilterGroupItem>

                            <fb:FilterGroupItem name="PriorFiscalYear" label="{i18n>PriorFiscalYear}" groupName="MainSearch" visibleInFilterBar="true" mandatory="true">
                                <fb:control>
                                    <MultiInput id="MI_PriorYear" width="10rem" showValueHelp="false" />
                                </fb:control>
                            </fb:FilterGroupItem>

                            <!-- 비교 기간 -->
                            <fb:FilterGroupItem name="CurrentStartMonth" label="{i18n>CurrentStartMonth}" groupName="MainSearch" visibleInFilterBar="true" mandatory="true">
                                <fb:control>
                                    <MultiInput id="MI_CurrentStartMonth" width="8rem" showValueHelp="false" />
                                </fb:control>
                            </fb:FilterGroupItem>

                            <fb:FilterGroupItem name="CurrentEndMonth" label="{i18n>CurrentEndMonth}" groupName="MainSearch" visibleInFilterBar="true" mandatory="true">
                                <fb:control>
                                    <MultiInput id="MI_CurrentEndMonth" width="8rem" showValueHelp="false" />
                                </fb:control>
                            </fb:FilterGroupItem>

                            <fb:FilterGroupItem name="CurrentFiscalYear" label="{i18n>CurrentFiscalYear}" groupName="MainSearch" visibleInFilterBar="true" mandatory="true">
                                <fb:control>
                                    <MultiInput id="MI_CurrentYear" width="10rem" showValueHelp="false" />
                                </fb:control>
                            </fb:FilterGroupItem>

                            <fb:FilterGroupItem groupName="FB_GROUP" name="GLAccount" label="{i18n>GLAccount}" labelTooltip="{i18n>GLAccount}" visibleInFilterBar="true">
                                <fb:control>
                                    <MultiInput id="MI_GL" width="60%" liveChange=".onLiveChange" valueHelpRequest=".onVHGL" suggestionRows="{
                                            path: 'oGLAccount>/'
                                        }">
                                        <suggestionRows>
                                            <ColumnListItem>
                                                <Label text="{oGLAccount>GLAccount}" />
                                                <Label text="{oGLAccount>GLAccountName}" />
                                            </ColumnListItem>
                                        </suggestionRows>
                                    </MultiInput>
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem groupName="FB_GROUP" name="GL0" label="{i18n>GL0}" visibleInFilterBar="true">
                                <fb:control>
                                    <CheckBox id="CB_GL0" selected="{Search>/GL0}" />
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <table:TreeTable id="T_Main" rowHeight="20" selectionMode="Single" busyIndicatorDelay="0" enableColumnReordering="false" nableBusyIndicator="true" rootLevel="1" visibleRowCountMode="Auto" filter="onColumnFilter">
                <table:extension>
                    <Bar>
                        <contentRight>
                            <SearchField id="SF_TableSearch" width="15rem" search="onTableSearch" />
                            <!-- 엔터/돋보기 클릭도 동일 동작 -->
                            <Button id="B_BookmarkSave" icon="sap-icon://bookmark" text="북마크 저장" press="onBookmarkSave" />
                            <Button id="B_BookmarkLoad" icon="sap-icon://folder-2" mode="MultiSelect" text="북마크 불러오기" press="onBookmarkLoad" />
                            <Button id="B_ExpandLevelDown" icon="sap-icon://less" text="단계" tooltip="한 단계 접기" press="onExpandLevelDown"/>
                            <Button id="B_ExpandLevelUp" icon="sap-icon://add" text="단계" tooltip="한 단계 펼치기" press="onExpandLevelUp" />
                            <Button icon="sap-icon://expand-group" press="onExpandAllPress" />
                            <Button icon="sap-icon://collapse-group" press="onCollapseAllPress" />
                            <Button id="B_Excel" busyIndicatorDelay="0" icon="sap-icon://excel-attachment" tooltip="엑셀 다운로드" press="onExport" />
                            <Button id="B_Print" busyIndicatorDelay="0" icon="sap-icon://print" tooltip="프린트" press="onPrint" />
                        </contentRight>
                    </Bar>
                </table:extension>
                <table:columns>
                    <!-- 내역 -->
                    <table:Column id="COL_NodeText" hAlign="Center" width="20rem" filterProperty="NodeText">
                        <Label design="Bold" text="{i18n>NodeText}" />
                        <table:template>
                            <Text textAlign="Begin" text="{NodeText}" />
                        </table:template>
                    </table:Column>

                    <!-- G/L 계정 -->
                    <table:Column id="COL_GlAccount" hAlign="Left" width="10rem" filterProperty="GlAccount">
                        <Label design="Bold" text="{i18n>GlAccount}" />
                        <table:template>
                            <Text textAlign="Left" text="{GlAccount}" />
                        </table:template>
                    </table:Column>
                    <!-- G/L 계정 내역-->
                    <table:Column id="COL_GlAccountText" hAlign="Left" width="25rem" headerMenu="M_GlAccountText" filterProperty="GlAccountText">
                        <Label design="Bold" text="{i18n>GlAccountText}" />
                        <table:template>
                            <Text textAlign="Left" text="{GlAccountText}" />
                        </table:template>
                    </table:Column>
                    <!-- 기간 잔액 -->
                    <table:Column id="COL_PeriodBalance" hAlign="End" width="14rem" filterProperty="PeriodBalance">
                        <Label design="Bold" text="{i18n>PeriodBalance}" />
                        <table:template>
                            <HBox justifyContent="End" width="100%">
                                <Link text="{
          parts: [
            { path: 'PeriodBalance' },
            { path: 'CompanyCodeCurrency' },
            { path: 'NodeText' }   
          ],
          formatter: '.formatter.currencyHideZeroForBsPl'
        }" press=".onPeriodBalancePress" visible="{= !!${GlAccount}}" />
                                <Text text="{
          parts: [
            { path: 'PeriodBalance' },
            { path: 'CompanyCodeCurrency' },
            { path: 'NodeText' }
          ],
          formatter: '.formatter.currencyHideZeroForBsPl'
        }" visible="{= !${GlAccount}}" />
                            </HBox>
                        </table:template>
                    </table:Column>

                    <!-- 비교 기간 잔액 -->
                    <table:Column id="COL_ComparisonBalance" hAlign="End" width="14rem" filterProperty="ComparisonBalance">
                        <Label design="Bold" text="{i18n>ComparisonBalance}" />
                        <table:template>
                            <HBox justifyContent="End" width="100%">
                                <Link text="{
          parts: [
            { path: 'ComparisonBalance' },
            { path: 'CompanyCodeCurrency' },
            { path: 'NodeText' }
          ],
          formatter: '.formatter.currencyHideZeroForBsPl'
        }" press=".onComparisonBalance" visible="{= !!${GlAccount}}" />
                                <Text text="{
          parts: [
            { path: 'ComparisonBalance' },
            { path: 'CompanyCodeCurrency' },
            { path: 'NodeText' }
          ],
          formatter: '.formatter.currencyHideZeroForBsPl'
        }" visible="{= !${GlAccount}}" />
                            </HBox>
                        </table:template>
                    </table:Column>

                    <!-- 절대 차이 -->
                    <table:Column id="COL_AbsoluteDifference" hAlign="End" width="12rem" filterProperty="AbsoluteDifference">
                        <Label design="Bold" text="{i18n>AbsoluteDifference}" />
                        <table:template>
                            <Text textAlign="End" text="{
    parts: [
      { path: 'AbsoluteDifference' },
      { path: 'CompanyCodeCurrency' },
      { path: 'NodeText' },
      { path: 'PeriodBalance' },
      { path: 'ComparisonBalance' }
    ],
    formatter: '.formatter.absDiffFixed2AutoScale'
  }" />
                        </table:template>
                    </table:Column>

                    <!-- 상대 차이 -->
                    <table:Column id="COL_RelativeDifference" hAlign="End" width="6rem" filterProperty="RelativeDifference">
                        <Label design="Bold" text="{i18n>RelativeDifference}" />
                        <table:template>
                            <Text textAlign="End" text="{
                             parts: [
        { path: 'RelativeDifference' },
        { path: 'NodeText'}
      ],
                             path : 'RelativeDifference' ,
                             formatter: '.formatter.formatAbsDiff'                             
        }" />
                        </table:template>
                    </table:Column>
                    <!-- 단위 -->
                    <table:Column id="COL_CompanyCodeCurrency" hAlign="Left" width="5rem" filterProperty="CompanyCodeCurrency">
                        <Label design="Bold" text="{i18n>CompanyCodeCurrency}" />
                        <table:template>
                            <Text textAlign="Left" text="{CompanyCodeCurrency}" />
                        </table:template>
                    </table:Column>
                </table:columns>
            </table:TreeTable>
        </f:content>
    </f:DynamicPage>
    <!-- <columnmenu:Menu id="M_GlAccountText">
        <columnmenu:items>
            <columnmenu:Item confirm="onColumnMenuConfirm" beforeOpen="onColumnMenuBeforeOpen" showResetButton="true" showCancelButton="true" label="filter" cancel="onColumnMenuCancel">
                <VBox >
                    <SearchField id="SF_GlAccountText" width="100%" liveChange="onColumnMenuSearch"/>
                    <List id="L_GlAccountText" mode="MultiSelect" multiSelectMode="Default">
                        <StandardListItem />
                    </List>
                </VBox>
            </columnmenu:Item>
        </columnmenu:items>
    </columnmenu:Menu> -->
    <columnmenu:Menu id="M_GlAccountText" beforeOpen=".onColumnMenuBeforeOpen">
        <columnmenu:items>
            <columnmenu:Item label="filter" confirm=".onColumnMenuConfirm" cancel=".onColumnMenuCancel" showResetButton="true" showCancelButton="true">
                <VBox>
                    <SearchField id="SF_GlAccountText" width="100%" liveChange=".onColumnMenuSearch"/>
                    <List id="L_GlAccountText" mode="MultiSelect" includeItemInSelection="true"/>
                </VBox>
            </columnmenu:Item>
        </columnmenu:items>
    </columnmenu:Menu>


</mvc:View>